{
  "name": "ataimo-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "build:platform": "esbuild scripts/migrate.mjs --bundle --platform=node --format=cjs --outfile=dist/migrate.cjs --external:pg-native && esbuild workers/platform.mjs --bundle --platform=node --format=cjs --outfile=dist/worker.cjs --external:pg-native",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "geist": "^1.4.2",
    "imapflow": "^2.2.5",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.52.0",
    "mailparser": "^3.9.36",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.0.15",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0"
  }
}
